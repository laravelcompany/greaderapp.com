---
// LeadsCaptain banner card, same family as phpteacher/ecudocs. Plain scoped
// CSS (these sites run Bootstrap themes, no Tailwind). Asset supplied by
// Stefan (public/leadscaptain_350x350_ad.gif). Dismissal persists for the
// session; closing the card also opens the link in a new tab.
---

<div id="lc-popup-card" class="lc-popup-card" role="dialog" aria-label="LeadsCaptain promotion">
  <button id="lc-popup-close" type="button" aria-label="Close popup and open LeadsCaptain in a new tab" class="lc-popup-close">
    &times;
  </button>
  <a id="lc-popup-link" href="https://leadscaptain.com" target="_blank" rel="noopener sponsored" class="lc-popup-link">
    <img src="/leadscaptain_350x350_ad.gif" alt="LeadsCaptain - find and reach your next customers" width="350" height="350" loading="lazy" />
  </a>
  <p class="lc-popup-note">Sponsored by LeadsCaptain</p>
</div>

<style>
  .lc-popup-card {
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 9999;
    width: 100%;
    max-width: 300px;
    padding: 16px;
    border-radius: 16px;
    border: 1px solid #1e293b;
    background: rgba(15, 23, 42, 0.95);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    transform: translateY(16px);
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
  }
  .lc-popup-card.lc-popup-visible {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
  }
  .lc-popup-close {
    position: absolute;
    top: 8px;
    right: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 0;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.7);
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .lc-popup-close:hover {
    background: rgba(255, 255, 255, 0.2);
    color: #fff;
  }
  .lc-popup-link {
    display: block;
  }
  .lc-popup-link img {
    display: block;
    width: 100%;
    height: auto;
    margin: 0 auto;
    border-radius: 12px;
  }
  .lc-popup-note {
    margin: 12px 0 0;
    text-align: center;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
  }
</style>

<script>
  const LC_POPUP_KEY = "lc-popup-dismissed";
  function lcTrack(eventName: string, params?: Record<string, string | undefined>) {
    try {
      if (typeof (window as any).gtag === "function") {
        (window as any).gtag("event", eventName, params || {});
      }
    } catch {
      // analytics blocked - never break the popup
    }
  }
  const card = document.getElementById("lc-popup-card");
  const closeButton = document.getElementById("lc-popup-close");
  const link = document.getElementById("lc-popup-link") as HTMLAnchorElement | null;

  function lcHideCard() {
    if (!card) return;
    card.classList.remove("lc-popup-visible");
    try {
      window.sessionStorage.setItem(LC_POPUP_KEY, "1");
    } catch {
      // storage unavailable - popup simply shows again next page
    }
  }

  function lcClosePopup() {
    // Stefan 2026-09-28: closing also opens the link in a new tab.
    lcTrack("leadscaptain_popup_close_click", {
      link_url: link?.href,
      page_path: window.location.pathname,
    });
    if (link) {
      window.open(link.href, "_blank", "noopener");
    }
    lcHideCard();
  }

  function lcMaybeOpenPopup() {
    if (!card) return;
    let dismissed = false;
    try {
      dismissed = window.sessionStorage.getItem(LC_POPUP_KEY) === "1";
    } catch {
      dismissed = false;
    }
    if (dismissed) return;
    card.classList.add("lc-popup-visible");
    lcTrack("leadscaptain_popup_view", { page_path: window.location.pathname });
  }

  if (card) {
    window.setTimeout(lcMaybeOpenPopup, 3000);
    closeButton?.addEventListener("click", lcClosePopup);
    link?.addEventListener("click", () => {
      lcTrack("leadscaptain_popup_click", {
        link_url: link.href,
        page_path: window.location.pathname,
      });
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && card.classList.contains("lc-popup-visible")) {
        lcHideCard();
      }
    });
  }
</script>
