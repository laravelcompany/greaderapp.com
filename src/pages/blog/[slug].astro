---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { posts } from '../../data/posts';
export function getStaticPaths() { return posts.map(post => ({ params: { slug: post.slug }, props: { post } })); }
const { post } = Astro.props;
---
<MarketingLayout title={`${post.title} - gReader News`} description={post.answer}>
  <article class="article-page shell">
    <nav aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/blog.html">Reading guides</a> / <span aria-current="page">{post.title}</span></nav>
    <header><h1>{post.title}</h1><p class="article-lead">{post.answer}</p></header>
    <div class="article-body">
      {post.sections.map(([heading, text]) => <section><h2>{heading}</h2><p>{text}</p></section>)}
      <section><h2>Sources and limits</h2><ul>{post.sources.map(([title,url]) => <li><a href={url}>{title}</a></li>)}</ul><p>Project documentation describes implementation and its limits. It does not certify every publisher, device or store rollout.</p></section>
      <section><h2>More reading</h2><ul>{posts.filter(other => other.slug !== post.slug).slice(0,3).map(other => <li><a href={`/blog/${other.slug}.html`}>{other.title}</a></li>)}</ul><p><a href="/faq.html">Product FAQ</a> · <a href="/privacy-policy.html">Privacy policy</a></p></section>
    </div>
  </article>
</MarketingLayout>
